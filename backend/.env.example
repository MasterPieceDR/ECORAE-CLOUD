# Copiar a .env para desarrollo local. En AWS estos valores llegan como variables de la tarea ECS y desde Secrets Manager.
ENTORNO=desarrollo
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NOMBRE=ecoraee
DB_USUARIO_API=ecoraee_api_svc
DB_CLAVE_API=cambiar
DB_USUARIO_MCP=ecoraee_mcp_svc
DB_CLAVE_MCP=cambiar
# DB_SECRET_ARN=arn:aws:secretsmanager:...   (en AWS reemplaza las 6 líneas anteriores)
# DB_SSL=true
AUTH_MODO=local
JWT_SECRETO=cambiar-por-un-valor-largo-y-aleatorio
# JWT_SECRET_ARN=arn:aws:secretsmanager:...
# Cognito (AUTH_MODO=cognito)
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxx
DEMO=true
ALMACEN_MODO=local
ALMACEN_DIR=./almacen
# ALMACEN_MODO=s3
# BUCKET_EVIDENCIAS=ecoraee-evidencias-<cuenta>
# BUCKET_CONTENIDOS=ecoraee-contenidos-<cuenta>
AWS_REGION=us-east-1
CORS_ORIGENES=http://localhost:5171
# Asistente conversacional (opcional). Sin clave, el panel funciona en modo herramientas.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-sonnet-5-5
